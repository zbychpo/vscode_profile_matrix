{
    "name": "profile-extension-matrix",
    "displayName": "%displayName%",
    "description": "%description%",
    "version": "1.0.2",
    "publisher": "soranoana",
    "repository": {
        "type": "git",
        "url": "https://github.com/Soranoana/vscode_profile_matrix.git"
    },
    "engines": {
        "vscode": "^1.133.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "l10n": "./l10n",
    "icon": "media/icon.png",
    "contributes": {
        "commands": [
            {
                "command": "profileExtensionMatrix.open",
                "title": "%command.open.title%"
            },
            {
                "command": "profileExtensionMatrix.refresh",
                "title": "%command.refresh.title%"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "profileExtensionMatrix",
                    "title": "%viewsContainer.title%",
                    "icon": "media/profile-extensions.svg"
                }
            ]
        },
        "views": {
            "profileExtensionMatrix": [
                {
                    "type": "webview",
                    "id": "profileExtensionMatrix.matrixView",
                    "name": "%view.matrix.name%"
                }
            ]
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "vscode:prepublish": "npm run compile"
    },
    "devDependencies": {
        "@types/node": "^22.10.1",
        "@types/vscode": "^1.125.0",
        "typescript": "^5.7.2"
    }
}